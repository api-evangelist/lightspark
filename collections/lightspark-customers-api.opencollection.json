{
  "opencollection": "1.0.0",
  "info": {
    "name": "Grid Agent Management Customers API",
    "version": "2025-10-13"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
