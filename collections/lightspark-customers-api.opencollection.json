          "http": {
            "method": "DELETE",
            "url": "https://api.lightspark.com/grid/2025-10-13/customers/:customerId",
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "System-generated unique customer identifier"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
