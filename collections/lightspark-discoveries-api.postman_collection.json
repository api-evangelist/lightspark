  "item": [
    {
      "id": "6c372429-58be-46fc-97f2-25e968d6a8a3",
      "name": "Discoveries",
      "description": {
        "content": "Endpoints for discovering available payment rails, banks, and providers for a given country and currency corridor.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "84640c68-934d-435a-a501-25ee6f5251d7",
          "name": "List available receiving institution names",
          "request": {
            "name": "List available receiving institution names",
            "description": {
              "content": "Retrieve available payment institution names for a given country and currency. Use this endpoint\nto look up supported banks and payment providers for a specific corridor.\nIf no country and currency parameter are provided, all payment institutions will be returned\n\nThe `bankName` field in each result is the value to pass as `bankName` when\ncreating an external account via `POST /customers/external-accounts`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "discoveries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "ISO 3166-1 alpha-2 country code (e.g. PH)"
                },
                {
                  "disabled": false,
                  "key": "currency",
                  "value": "<string>",
                  "description": "ISO 4217 currency code (e.g. PHP)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "0ba6ae65-5144-45e8-9e16-87ad954e1ab8",
              "name": "Successful operation",
