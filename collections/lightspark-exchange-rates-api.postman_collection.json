  "item": [
    {
      "id": "d07a9760-ec1e-4f76-b9c8-1d45393a7e5c",
      "name": "Exchange Rates",
      "description": {
        "content": "Endpoints for retrieving cached foreign exchange rates. Rates are cached for approximately 5 minutes and include platform-specific fees.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "768710c0-b014-4542-8b0c-2f878a852cac",
          "name": "Get exchange rates",
          "request": {
            "name": "Get exchange rates",
            "description": {
              "content": "Retrieve cached exchange rates for currency corridors. Returns FX rates that are cached\nfor approximately 5 minutes. Rates include fees specific to your platform for authenticated requests.\n\n**Filtering Options:**\n- Filter by source currency to get all available destination corridors\n- Filter by specific destination currency or currencies\n- Provide a sending amount to get calculated receiving amounts\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "exchange-rates"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "sourceCurrency",
                  "value": "<string>",
                  "description": "Filter by source currency code (e.g., USD)"
                },
                {
                  "disabled": false,
                  "key": "destinationCurrency",
                  "value": "<string>",
                  "description": "Filter by destination currency code(s). Can be repeated for multiple currencies (e.g., &destinationCurrency=INR&destinationCurrency=GBP)"
                },
                {
                  "disabled": false,
                  "key": "destinationCurrency",
                  "value": "<string>",
                  "description": "Filter by destination currency code(s). Can be repeated for multiple currencies (e.g., &destinationCurrency=INR&destinationCurrency=GBP)"
                },
                {
                  "disabled": false,
                  "key": "sendingAmount",
                  "value": "10000",
                  "description": "Sending amount in the smallest unit of the source currency (e.g., cents for USD).  If no amount is provided, the default is 10000 in the sending currency smallest unit."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
          "response": [
